# Autonomous Incident Response — Environment Configuration
# Copy this to .env and fill in values.

# App
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# LLM — Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# LLM — OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Which provider to use as primary: "anthropic" | "openai"
LLM_PROVIDER=anthropic

# Incident Pipeline
RCA_CONFIDENCE_THRESHOLD=0.7
RCA_MAX_RETRIES=1
APPROVAL_TIMEOUT_MINUTES=15

# Connect /incidents/trigger to the real Docker/Toxiproxy environment.
#   auto -> use the real env only when the IRAS service stack is running
#   on   -> always use the real env
#   off  -> stay in mock mode (signals + in-memory remediation)
REAL_ENV=auto

# Set to true when the backend runs inside the docker-compose network, so
# health verification reaches services by DNS name (http://payment-service:5000)
# instead of published host ports (http://localhost:5001).
IRAS_SERVICE_DNS=false

# API security (issue #31).  Leave API_KEY empty to keep auth disabled (local
# dev / tests).  When set, every mutating endpoint that drives the real
# Docker/Toxiproxy environment requires the header `X-API-Key: <value>`.
API_KEY=

# Comma-separated browser origins allowed to call the API (the dashboard runs
# cross-origin on :3000 against the API on :8000).  Never use "*": the API
# operates real Docker/Toxiproxy state.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
